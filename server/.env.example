PORT=4000
HOST=0.0.0.0
NODE_ENV=development
DB_PATH=./data/nexussync.db
CORS_ORIGIN=*

# AI Conflict Advisor (Ollama Cloud)
# Base URL for Ollama Cloud API (default: https://ollama.com)
OLLAMA_BASE_URL=https://ollama.com
# Ollama Cloud API key obtained from https://ollama.com/settings/keys
OLLAMA_API_KEY=your_ollama_api_key_here
# Ollama Cloud model identifier (e.g., gemma4:cloud)
OLLAMA_MODEL=gemma4:cloud
# Bounded timeout in milliseconds for inference requests
OLLAMA_TIMEOUT_MS=15000
